# Copy to .env.local / Vercel env. Edit URLs and addresses after deploy.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=

# testnet | mainnet
NEXT_PUBLIC_TON_NETWORK=testnet
NEXT_PUBLIC_TON_CONNECT_MANIFEST_URL=https://YOUR_DOMAIN/tonconnect-manifest.json
NEXT_PUBLIC_TWA_RETURN_URL=https://t.me/YOUR_BOT/app

# After contract deploy, paste addresses here
NEXT_PUBLIC_DRILL_JETTON_MASTER=
NEXT_PUBLIC_NFT_COLLECTION_ADDRESS=

# Pass mint price shown / sent from the app
NEXT_PUBLIC_MINT_PRICE_TON=1
NEXT_PUBLIC_MINT_SEND_TON=1.15

# Optional RPC
TON_RPC_URL=https://testnet.toncenter.com/api/v2/jsonRPC
